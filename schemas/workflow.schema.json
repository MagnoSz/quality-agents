{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quality-agents/workflow",
  "title": "Quality Agents declarative workflow",
  "type": "object",
  "required": ["id", "title", "steps"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string" },
    "status": { "type": "string", "enum": ["stable", "draft", "planned"] },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "skill", "gate"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "skill": { "type": "string" },
          "description": { "type": "string" },
          "dependsOn": { "type": "array", "items": { "type": "string" } },
          "gate": { "type": "string", "enum": ["none", "approval", "input"] },
          "optional": { "type": "boolean" },
          "outputs": { "type": "array", "items": { "type": "string", "pattern": "^workspace/projects/<project-id>/" } }
        }
      }
    }
  }
}
